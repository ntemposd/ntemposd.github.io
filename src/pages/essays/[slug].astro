---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Share from '../../components/Share.astro';
import SubstackSubscribe from '../../components/SubstackSubscribe.astro';

export async function getStaticPaths() {
  const entries = await getCollection('posts');
  return entries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

// helpers
const normTags = (raw: unknown) =>
  Array.isArray(raw)
    ? raw
    : typeof raw === 'string'
      ? raw.split(',').map((t) => t.trim()).filter(Boolean)
      : [];

const isAstroImage = (img: unknown): img is ImageMetadata =>
  !!img && typeof img === 'object' && 'src' in (img as any);

// props
const { entry } = Astro.props;
const { Content } = await entry.render();

// Normalize date (support string or Date) by coercing via `new Date()`
const isoDate = new Date(entry.data.date).toISOString().split('T')[0];

const tags = normTags(entry.data.tags);

// Prefer `image`, fall back to `cover` (use `any` to avoid strict typing issues)
const rawCover = (entry.data as any).image ?? (entry.data as any).cover ?? null;

// Resolve hero cover to ImageMetadata if it’s a string like "/posts/foo.png"
const toBase = (p: string) => p.split('/').pop()!.toLowerCase();
const postAssetMeta = import.meta.glob('../../assets/posts/*.{png,jpg,jpeg,webp,avif}', { eager: true });

const metaByName = new Map<string, ImageMetadata>();
for (const [k, v] of Object.entries(postAssetMeta)) {
  const val = (v as any).default ?? v;
  if (val) metaByName.set(toBase(k), val as ImageMetadata);
}

let cover: ImageMetadata | null = null;
if (isAstroImage(rawCover)) {
  cover = rawCover;
} else if (typeof rawCover === 'string') {
  cover = metaByName.get(toBase(rawCover)) ?? null;
}

const postUrl = new URL(Astro.url.pathname, (Astro.site ?? Astro.url.origin)).toString();

// Map assets to hashed URLs for client-side rewrite of inline <img src="/posts/...">
const postAssetUrls = import.meta.glob('../../assets/posts/*.{png,jpg,jpeg,webp,avif,svg}', {
  eager: true,
  query: '?url',
  import: 'default',
});
const urlMap = Object.fromEntries(
  Object.entries(postAssetUrls).map(([k, url]) => [toBase(k), url as string])
);

// Compute an absolute og image URL for social cards.
// Prefer a PNG/JPEG original post image when the frontmatter points to one
// (Twitter historically has spotty WebP/AVIF support). Fall back to the
// bundled hashed URL if needed, and finally to the ImageMetadata src.
const siteOrigin = (Astro.site ?? Astro.url.origin).toString();
let ogImage: string | null = null;

if (typeof rawCover === 'string') {
  // absolute URL from the original source path (e.g. '/posts/foo.png')
  const orig = new URL(rawCover, siteOrigin).toString();

  // If the raw path points to a PNG/JPEG/GIF, prefer it for OG (safe for Twitter)
  if (/\.(png|jpe?g|gif)$/i.test(rawCover)) {
    ogImage = orig;
  } else {
    // otherwise prefer the bundled hashed URL (may be webp/avif) if available
    const mapped = urlMap[toBase(rawCover)];
    if (mapped) ogImage = new URL(mapped, siteOrigin).toString();
    else ogImage = orig;
  }
} else if (cover && (cover as any).src) {
  ogImage = new URL((cover as any).src, siteOrigin).toString();
}
---

<Layout
  title={`${entry.data.title} — ntemposd`}
  description={entry.data.excerpt ?? 'Essays by Dimitrios Ntempos on product, systems, data, and building.'}
  entry={entry}
  ogImage={ogImage}
>
  <h1 class="text-3xl font-semibold mb-2">{entry.data.title}</h1>
  {entry.data.excerpt && <p class="prose prose-neutral max-w-none lg:prose-lg">{entry.data.excerpt}</p>}

  <p class="inline-flex items-center rounded-md bg-gray-400/10 px-2 py-1 text-xs font-thin text-gray-600 mb-4">
    {isoDate}
  </p>

  {tags.length > 0 && (
    <div class="flex flex-wrap gap-2 mb-6">
      {tags.map((tag) => (
        <span class="text-xs bg-indigo-100 text-indigo-700 px-2 py-1 rounded-md font-medium">#{tag}</span>
      ))}
    </div>
  )}

  {/* Hero cover (Image component) */}
  {cover && (
    <div class="aspect-[16/9] overflow-hidden rounded-2xl bg-gray-50 mb-6">
      <Image
        src={cover}
        alt={entry.data.title}
        class="w-full h-full object-cover"
        widths={[768, 1024, 1440]}
        sizes="(max-width: 1024px) 100vw, 1024px"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </div>
  )}

  <article id="post-body" class="prose prose-neutral max-w-none lg:prose-xl" data-urlmap={JSON.stringify(urlMap)}>
    <Content />
  </article>

  {/* Tiny client-side fix: rewrite /posts/filename.ext to the bundled URL */}
  <script type="module">
    // Rewrite inline markdown <img src="/posts/..."> to the dev/prod-served hashed URLs
    const root = document.getElementById('post-body');
    const map = root && root.dataset.urlmap ? JSON.parse(root.dataset.urlmap) : {};
    if (root) {
      root.querySelectorAll('img[src^="/posts/"]').forEach((img) => {
        const src = img.getAttribute('src');
        if (!src) return;
        const fname = src.split('/').pop().toLowerCase();
        const url = map[fname];
        if (url && img.src !== url) img.src = url; // avoid redundant swaps (reduce flicker)
      });
    }
    // Ensure page scrolls to top on load
    if (!window.location.hash) {
      window.scrollTo({ top: 0, left: 0, behavior: 'auto' });
    }  </script>

  <Share postTitle={entry.data.title} postUrl={postUrl} />
  <SubstackSubscribe />
</Layout>

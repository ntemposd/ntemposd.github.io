---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { createMarkdownProcessor } from '@astrojs/markdown-remark';
import Share from '../../components/Share.astro';
import MailingListSubscribe from '../../components/MailingListSubscribe.astro';
import { rehypeLazyContentImages } from '../../lib/rehype-lazy-content-images.mjs';

export async function getStaticPaths() {
  const entries = await getCollection('posts');
  return entries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

// helpers
const normTags = (raw: unknown) =>
  Array.isArray(raw)
    ? raw
    : typeof raw === 'string'
      ? raw.split(',').map((t) => t.trim()).filter(Boolean)
      : [];

const isAstroImage = (img: unknown): img is ImageMetadata =>
  !!img && typeof img === 'object' && 'src' in (img as any);

// props
const { entry } = Astro.props;

// Normalize date (support string or Date) by coercing via `new Date()`
const fullDate = new Date(entry.data.date).toLocaleDateString('en-US', { 
  year: 'numeric', 
  month: 'long', 
  day: 'numeric' 
});

const tags = normTags(entry.data.tags);

// Prefer `image`, fall back to `cover` (use `any` to avoid strict typing issues)
const rawCover = (entry.data as any).image ?? (entry.data as any).cover ?? null;

// Resolve hero cover to ImageMetadata if it’s a string like "/posts/foo.png"
const toBase = (p: string) => p.split('/').pop()!.toLowerCase();
const postAssetMeta = import.meta.glob('../../assets/posts/*.{png,jpg,jpeg,webp,avif}', { eager: true });

const metaByName = new Map<string, ImageMetadata>();
for (const [k, v] of Object.entries(postAssetMeta)) {
  const val = (v as any).default ?? v;
  if (val) metaByName.set(toBase(k), val as ImageMetadata);
}

let cover: ImageMetadata | null = null;
if (isAstroImage(rawCover)) {
  cover = rawCover;
} else if (typeof rawCover === 'string') {
  cover = metaByName.get(toBase(rawCover)) ?? null;
}

const postPath =
  Astro.url.pathname.endsWith('/') || /\.[^/]+$/.test(Astro.url.pathname)
    ? Astro.url.pathname
    : `${Astro.url.pathname}/`;
const postUrl = new URL(postPath, Astro.site ?? Astro.url.origin).toString();

// Bundled URLs for inline figures and for non-PNG/JPEG Open Graph fallbacks.
const postAssetUrls = import.meta.glob('../../assets/posts/*.{png,jpg,jpeg,webp,avif,svg}', {
  eager: true,
  query: '?url',
  import: 'default',
});
const urlMap = Object.fromEntries(
  Object.entries(postAssetUrls).map(([k, url]) => [toBase(k), url as string])
);

// Resolve /posts/file.ext to the bundled asset URL while the HTML is rendered.
// External and unknown sources stay unchanged so they are not pointed at a missing file.
const resolveInlineSrc = (src: string) => {
  if (!src.startsWith('/posts/')) return null;
  const name = src.split('?')[0].split('/').pop()?.toLowerCase();
  if (!name) return null;
  return urlMap[name] ?? null;
};
const markdown =
  globalThis.__essayMarkdown ??
  (globalThis.__essayMarkdown = await createMarkdownProcessor({
    rehypePlugins: [[rehypeLazyContentImages, { resolveSrc: resolveInlineSrc }]],
  }));
const postHtml = (await markdown.render(entry.body ?? '')).code;

// Compute an absolute og image URL for social cards.
// Prefer a PNG/JPEG original post image when the frontmatter points to one
// (Twitter historically has spotty WebP/AVIF support). Fall back to the
// bundled hashed URL if needed, and finally to the ImageMetadata src.
const siteOrigin = (Astro.site ?? Astro.url.origin).toString();
let ogImage: string | null = null;

if (typeof rawCover === 'string') {
  // absolute URL from the original source path (e.g. '/posts/foo.png')
  const orig = new URL(rawCover, siteOrigin).toString();

  // If the raw path points to a PNG/JPEG/GIF, prefer it for OG (safe for Twitter)
  if (/\.(png|jpe?g|gif)$/i.test(rawCover)) {
    ogImage = orig;
  } else {
    // otherwise prefer the bundled hashed URL (may be webp/avif) if available
    const mapped = urlMap[toBase(rawCover)];
    if (mapped) ogImage = new URL(mapped, siteOrigin).toString();
    else ogImage = orig;
  }
} else if (cover && (cover as any).src) {
  ogImage = new URL((cover as any).src, siteOrigin).toString();
}

const description =
  (typeof entry.data.excerpt === 'string' && entry.data.excerpt.trim()) ||
  'An essay by Dimitrios Ntempos, a technical product manager working on integrations, data and AI, about product, systems, and building.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: entry.data.title,
  description,
  datePublished: entry.data.date,
  ...(ogImage ? { image: ogImage } : {}),
  author: {
    '@type': 'Person',
    name: 'Dimitrios Ntempos',
    url: new URL('/', siteOrigin).href,
  },
  url: postUrl,
};
---

<Layout
  title={`${entry.data.title} — Dimitrios Ntempos`}
  description={description}
  entry={entry}
  ogImage={ogImage}
  publishedTime={entry.data.date}
  jsonLd={jsonLd}
>
  <style>
    :global(.dots-overlay) {
      -webkit-mask-image: radial-gradient(transparent 0%, rgba(0,0,0,0.3) 40%, #000 80%);
      mask-image: radial-gradient(transparent 0%, rgba(0,0,0,0.3) 40%, #000 80%);
    }
  </style>

  <div class="relative bg-white -mx-4 px-4 py-6">
    <h1 class="text-3xl font-semibold mb-3">{entry.data.title}</h1>
    
    <div class="flex flex-wrap items-center gap-2 mb-4">
      <span class="inline-flex items-center rounded-md bg-white/90 backdrop-blur-sm border border-white px-2 py-1 text-xs font-medium text-gray-900 shadow-md whitespace-nowrap">
        {fullDate}
      </span>
      {tags.map((tag) => (
        <span class="text-xs bg-gray-100 px-2 py-1 rounded-md text-gray-600 dark:bg-gray-700 dark:text-gray-300 whitespace-nowrap">{tag}</span>
      ))}
    </div>

    {entry.data.excerpt && <p class="prose prose-neutral max-w-none lg:prose-lg mb-6">{entry.data.excerpt}</p>}

    {/* Hero cover (Image component) */}
    {cover && (
      <div class="relative aspect-[16/9] overflow-hidden rounded-2xl bg-gray-50 mb-6">
        <Image
          src={cover}
          alt={entry.data.title}
          class="absolute inset-0 h-full w-full object-cover"
          widths={[768, 1024, 1440]}
          sizes="(max-width: 1024px) 100vw, 1024px"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>
    )}

    <article id="post-body" class="prose prose-neutral max-w-none lg:prose-xl font-normal" set:html={postHtml} />
  </div>

  <Share postTitle={entry.data.title} postUrl={postUrl} />
  <MailingListSubscribe />
</Layout>

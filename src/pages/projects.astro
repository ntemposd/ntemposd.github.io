---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

const PROJECT_TYPES = ['Products', 'Experiments', 'Community'] as const;

const sectionDescriptions: Record<(typeof PROJECT_TYPES)[number], string> = {
  Products: 'Small independent products, turning ideas into systems that people actually use.',
  Experiments: 'Explorations through apps and prototypes, used to understand how new technologies behave in practice.',
  Community: 'Work with local tech communities, bringing people together through events and shared initiatives.',
};

const normalizeProjectType = (value?: string) => {
  const normalized = value?.trim().toLowerCase();

  switch (normalized) {
    case 'product':
    case 'products':
      return 'Products';
    case 'experiment':
    case 'experiments':
      return 'Experiments';
    case 'community':
      return 'Community';
    default:
      return null;
  }
};

// higher order first
const projects = (await getCollection('projects')).sort(
  (a, b) => (b.data.order ?? 0) - (a.data.order ?? 0)
);

let eagerIndex = 0;
const sections = PROJECT_TYPES.map((title) => ({
  title,
  description: sectionDescriptions[title],
  items: projects
    .filter((project) => normalizeProjectType(project.data.type) === title)
    .map((project) => ({ project, eagerIndex: eagerIndex++ })),
}));

// Grab all rasters you placed under src/assets/projects
const rasters = import.meta.glob('../assets/projects/*.{png,jpg,jpeg,webp,avif}', { eager: true });

// Resolve by **basename only**, so frontmatter like "/notion/projects/foo.webp" finds "foo.png/webp/avif"
const resolveAsset = (pathStr: string) => {
  const base = pathStr.split('/').pop()?.replace(/\.[^.]+$/, '');
  if (!base) return null;
  for (const [k, mod] of Object.entries(rasters)) {
    if (new RegExp(`/${base}\\.(png|jpe?g|webp|avif)$`, 'i').test(k)) {
      // @ts-ignore - Vite default export is the asset URL/metadata
      return (mod as any).default ?? mod;
    }
  }
  return null;
};

const WIDTHS = [480, 768, 1024, 1440];
const SIZES = '(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw';

// eager strategy: first 6 images always eager
const isEager = (i: number) => i < 6;
---

<Layout
  title="Projects — Dimitrios Ntempos"
  description="Selected projects across APIs, data tools, and product systems, with practical outcomes and lessons learned."
>
  <section class="mb-12">
    <h1 class="text-3xl font-bold mb-2 text-gray-900">What I build</h1>
    <p class="text-gray-700 mb-10 max-w-none">
      A collection of products, experiments, and community work I've built or contributed to.
    </p>

    <div class="space-y-14">
      {
        sections.map((section) => (
          <section>
            <div class="mb-6">
              <h2 class="text-2xl font-bold text-gray-900">{section.title}</h2>
              <p class="mt-2 max-w-2xl text-sm leading-relaxed text-gray-700">{section.description}</p>
            </div>

            {section.items.length > 0 ? (
              <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
                {section.items.map(({ project: p, eagerIndex: index }) => {
                  const external = p.data.link?.startsWith('http');
                  const tags = Array.isArray(p.data.tags) ? p.data.tags : [];
                  const src = p.data.image ? resolveAsset(p.data.image) : null;
                  const eager = isEager(index);

                  return (
                    <a
                      href={p.data.link}
                      target={external ? '_blank' : undefined}
                      rel={external ? 'noopener noreferrer' : undefined}
                      class="group block rounded-2xl bg-white border border-gray-100 overflow-hidden
                             shadow-sm hover:shadow-lg transition-all duration-300 hover:-translate-y-1"
                    >
                      <div class="aspect-[16/9] overflow-hidden bg-gray-50">
                        {src ? (
                          <Image
                            src={src}
                            alt={p.data.title}
                            widths={WIDTHS}
                            sizes={SIZES}
                            loading={eager ? 'eager' : 'lazy'}
                            fetchpriority={index === 0 ? 'high' : (eager ? 'low' : 'low')}
                            decoding="async"
                            class="w-full h-full object-contain p-6 group-hover:scale-100 transition-transform duration-300 ease-out"
                          />
                        ) : (
                          <div class="w-full h-full grid place-items-center text-gray-400 text-sm">
                            No image
                          </div>
                        )}
                      </div>

                      <div class="p-5">
                        <h3 class="text-lg font-semibold mb-2 text-gray-900">{p.data.title}</h3>
                        <div class="flex flex-wrap gap-2 mb-3">
                          {tags.map((t) => (
                            <span class="text-xs bg-gray-100 px-2 py-1 rounded-md text-gray-600 dark:bg-gray-700 dark:text-gray-300">{t}</span>
                          ))}
                        </div>
                        <p class="text-gray-700 text-sm leading-relaxed">{p.data.blurb}</p>
                      </div>
                    </a>
                  );
                })}
              </div>
            ) : (
              <p class="text-sm text-gray-500">No projects in this section yet.</p>
            )}
          </section>
        ))
      }
    </div>
  </section>
</Layout>

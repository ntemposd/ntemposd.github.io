---
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('posts');
  return entries.map((entry) => ({
    params: { slug: entry.slug },
  }));
}

const destination = `/essays/${Astro.params.slug}/`;
const canonical = new URL(destination, Astro.site ?? 'https://ntemposd.me').href;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`0;url=${destination}`} />
    <link rel="canonical" href={canonical} />
    <title>Redirecting...</title>
    <script is:inline>
      const canonical = document.querySelector('link[rel="canonical"]');
      if (canonical && canonical.href) window.location.replace(canonical.href);
    </script>
  </head>
  <body>
    <p>
      Redirecting to <a href={destination}>{destination}</a>
    </p>
  </body>
</html>

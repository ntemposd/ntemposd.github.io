---
const destination = '/essays/';
const canonical = new URL(destination, Astro.site ?? 'https://ntemposd.me').href;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`0;url=${destination}`} />
    <link rel="canonical" href={canonical} />
    <title>Redirecting...</title>
    <script is:inline>
      window.location.replace('/essays/');
    </script>
  </head>
  <body>
    <p>
      Redirecting to <a href={destination}>{destination}</a>
    </p>
  </body>
</html>

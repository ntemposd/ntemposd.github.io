---
interface Props {
  buttondownUsername?: string;
}

const { buttondownUsername = 'ntemposd' } = Astro.props;
---

<div class="mt-8 border-t pt-6">
  <h3 class="text-sm font-semibold text-gray-600 mb-3">Subscribe to my newsletter</h3>
  <form
    action={`https://buttondown.com/api/emails/embed-subscribe/${buttondownUsername}`}
    method="post"
    class="flex flex-wrap gap-2"
    referrerpolicy="unsafe-url"
  >
    <input
      type="email"
      name="email"
      placeholder="Enter your email"
      required
      class="rounded-lg border bg-white px-4 py-1.5 text-sm min-w-[240px] hover:bg-gray-50 transition focus:outline-none focus:ring-2 focus:ring-gray-300"
    />
    <button
      type="submit"
      class="rounded-lg border px-3 py-1.5 text-sm hover:bg-gray-50 transition"
    >
      Subscribe
    </button>
  </form>
  
  <p class="text-xs text-gray-500 mt-3">
    No spam, unsubscribe anytime. Powered by 
    <a href="https://buttondown.com" target="_blank" rel="noopener noreferrer" class="underline hover:text-gray-700">
      Buttondown
    </a>.
  </p>
</div>
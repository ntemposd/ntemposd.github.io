---
interface Props {
  substackUsername?: string;
}

const { substackUsername = 'ntemposd' } = Astro.props;
---

<div class="mt-8 border-t pt-6">
  <div class="bg-gradient-to-r from-indigo-50 to-purple-50 rounded-lg p-6">
    <h3 class="text-lg font-semibold text-gray-900 mb-2">Subscribe to my newsletter</h3>
    <p class="text-gray-600 text-sm mb-4">Get the latest posts delivered to your inbox.</p>
    
    <iframe 
      src={`https://${substackUsername}.substack.com/embed`}
      width="100%" 
      height="150"
      style="border:0; background:white; border-radius: 8px;"
      frameborder="0" 
      scrolling="no"
    ></iframe>
    
    <p class="text-xs text-gray-500 mt-2">No spam, unsubscribe anytime.</p>
  </div>
</div>
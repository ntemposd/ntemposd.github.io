---
const { gaId } = Astro.props;
---

<div
  id="analytics-banner"
  class="analytics-banner"
  data-ga-id={gaId}
  role="region"
  aria-labelledby="analytics-banner-text"
  tabindex="-1"
  hidden
>
  <div class="analytics-content">
    <p id="analytics-banner-text">
      I use Google Analytics cookies for anonymous usage stats — which pages get read, not who you
      are. You can say no.
    </p>
    <div class="analytics-actions">
      <button type="button" id="analytics-accept" aria-pressed="false">Accept</button>
      <button type="button" id="analytics-reject" aria-pressed="false">Reject</button>
    </div>
  </div>
</div>

<style>
  /*
    Colors are for the light page. html.dark inverts the whole document, so the
    banner flips with it and stays legible. Don't paint a second dark theme here
    or it will invert again.
  */
  .analytics-banner {
    position: fixed;
    z-index: 999;
    left: 0;
    right: 0;
    bottom: 1rem;
    width: min(42rem, calc(100% - 2rem));
    margin-inline: auto;
    padding: 1rem 1.1rem;
    background: #fff;
    color: rgb(55, 65, 81);
    border: 1px solid rgb(156, 163, 175);
    border-radius: 0.75rem;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
  }

  .analytics-banner[hidden] {
    display: none;
  }

  .analytics-banner:focus-visible {
    outline: 2px solid rgb(17, 24, 39);
    outline-offset: 3px;
  }

  .analytics-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1rem;
  }

  #analytics-banner-text {
    margin: 0;
    flex: 1;
    font-size: 0.9rem;
    line-height: 1.45;
    color: rgb(55, 65, 81);
  }

  .analytics-actions {
    display: flex;
    flex-shrink: 0;
    gap: 0.5rem;
  }

  .analytics-actions button {
    min-width: 6.5rem;
    min-height: 2.75rem;
    padding: 0.5rem 1rem;
    border: 1px solid rgb(107, 114, 128);
    border-radius: 0.375rem;
    background: #fff;
    color: rgb(17, 24, 39);
    font: inherit;
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.2;
    cursor: pointer;
  }

  .analytics-actions button:hover {
    background: rgb(243, 244, 246);
  }

  .analytics-actions button:focus-visible {
    outline: 2px solid rgb(17, 24, 39);
    outline-offset: 2px;
  }

  .analytics-actions button[aria-pressed='true'] {
    box-shadow: inset 0 0 0 1px rgb(17, 24, 39);
  }

  @media (max-width: 640px) {
    .analytics-content {
      flex-direction: column;
      align-items: stretch;
    }

    .analytics-actions button {
      flex: 1;
    }
  }
</style>

<script is:inline>
  (() => {
    const KEY = 'analytics-consent';
    const banner = document.getElementById('analytics-banner');
    if (!banner) return;

    const gaId = banner.getAttribute('data-ga-id');
    if (!gaId) return;

    const acceptButton = document.getElementById('analytics-accept');
    const rejectButton = document.getElementById('analytics-reject');

    const readConsent = () => {
      try {
        const value = localStorage.getItem(KEY);
        return value === 'accepted' || value === 'rejected' ? value : null;
      } catch {
        return null;
      }
    };

    const writeConsent = (value) => {
      try {
        localStorage.setItem(KEY, value);
      } catch {
        /* private mode: honor the click for this page only */
      }
    };

    const loadAnalytics = () => {
      window['ga-disable-' + gaId] = false;
      if (window.__gaLoaded) {
        if (typeof window.gtag === 'function') window.gtag('config', gaId);
        return;
      }
      window.__gaLoaded = true;
      window.dataLayer = window.dataLayer || [];
      window.gtag = function gtag() {
        window.dataLayer.push(arguments);
      };
      window.gtag('js', new Date());
      window.gtag('config', gaId);
      const script = document.createElement('script');
      script.async = true;
      script.src = 'https://www.googletagmanager.com/gtag/js?id=' + encodeURIComponent(gaId);
      document.head.appendChild(script);
    };

    const stopAnalytics = () => {
      window['ga-disable-' + gaId] = true;
      document.cookie.split(';').forEach((part) => {
        const name = (part.split('=')[0] || '').trim();
        if (!name || (name !== '_ga' && name !== '_gid' && name.indexOf('_ga_') !== 0)) return;
        document.cookie = name + '=; Max-Age=0; path=/; SameSite=Lax';
      });
    };

    const syncPressed = () => {
      const choice = readConsent();
      if (acceptButton)
        acceptButton.setAttribute('aria-pressed', choice === 'accepted' ? 'true' : 'false');
      if (rejectButton)
        rejectButton.setAttribute('aria-pressed', choice === 'rejected' ? 'true' : 'false');
    };

    const settingsButton = () => document.getElementById('cookie-settings');

    const setOpen = (open) => {
      banner.hidden = !open;
      const settings = settingsButton();
      if (settings) settings.setAttribute('aria-expanded', open ? 'true' : 'false');
    };

    const closeBanner = () => {
      setOpen(false);
      const settings = settingsButton();
      if (settings) settings.focus({ preventScroll: true });
    };

    syncPressed();
    const choice = readConsent();
    if (choice === 'accepted') loadAnalytics();
    else if (choice !== 'rejected') setOpen(true);

    if (acceptButton) {
      acceptButton.addEventListener('click', () => {
        writeConsent('accepted');
        syncPressed();
        loadAnalytics();
        closeBanner();
      });
    }

    if (rejectButton) {
      rejectButton.addEventListener('click', () => {
        writeConsent('rejected');
        syncPressed();
        stopAnalytics();
        closeBanner();
      });
    }

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || banner.hidden) return;
      closeBanner();
    });

    const bindSettings = () => {
      const settings = settingsButton();
      if (!settings || settings.dataset.bound === 'true') return;
      settings.dataset.bound = 'true';
      settings.setAttribute('aria-expanded', banner.hidden ? 'false' : 'true');
      settings.addEventListener('click', () => {
        syncPressed();
        setOpen(true);
        banner.focus({ preventScroll: true });
      });
    };

    if (document.readyState === 'loading')
      document.addEventListener('DOMContentLoaded', bindSettings);
    else bindSettings();
  })();
</script>

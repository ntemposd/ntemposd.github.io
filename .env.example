# Notion API
# Omit NOTION_SECRET to build from the content already committed in this repo.
NOTION_SECRET=your_notion_api_secret_here
NOTION_POSTS_DB_ID=your_posts_database_id
NOTION_PROJECTS_DB_ID=your_projects_database_id
NOTION_EXPERIENCE_DB_ID=your_experience_database_id
NOTION_WORKING_DB_ID=your_working_database_id

# Optional: Google Analytics (if used)
# PUBLIC_GA_ID=your_ga_id

# Optional: Customize Notion properties
# NOTION_POSTS_DATE_PROP=Date
# NOTION_POSTS_STRICT_DATE=true
